/dev/block/platform/bootdevice/by-name/system   /         ext4 ro wait,slotselect,recoveryonly
/dev/block/platform/bootdevice/by-name/vendor   /vendor   ext4 ro wait,slotselect,recoveryonly
/dev/block/platform/bootdevice/by-name/product  /product  ext4 ro wait,slotselect,recoveryonly
/dev/block/platform/bootdevice/by-name/userdata /data     f2fs noatime,nosuid,nodev,discard,noflush_merge wait,check,quota,reservedsize=128M,formattable,resize,fileencryption=aes-256-xts
/dev/block/platform/bootdevice/by-name/boot     /boot     emmc defaults defaults
